<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>マイ アプリリンク集</title>
  <style>
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      background-color: #f4f6f8;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
      margin: 0;
    }
  　h1 {
      color: #333;
      margin-bottom: 20px;
    }
    .container {
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    .app-button {
      display: block;
      padding: 16px;
      background-color: #ffffff;
      color: #333;
      text-decoration: none;
      text-align: center;
      font-weight: bold;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .app-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>

  <h1>おすすめアプリ・サイト</h1>

  <div class="container">
    <a href="line://" class="app-button">LINEを開く</a>

    <!-- X (旧Twitter) アプリを開く -->
    <a href="twitter://" class="app-button">X (Twitter) を開く</a>

    <!-- YouTubeアプリを開く -->
    <a href="youtube://" class="app-button">YouTubeを開く</a>

    <!-- 自作アプリやその他スキームを指定する場合 -->
    <!-- <a href="myapp://" class="app-button">自作アプリを開く</a> -->
  </div>

</body>
</html>
